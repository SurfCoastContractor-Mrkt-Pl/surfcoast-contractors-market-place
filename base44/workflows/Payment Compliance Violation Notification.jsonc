{
  "name": "Payment Compliance Violation Notification",
  "description": "Sends email notification when off-platform payment is detected on a contractor's account",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"payment_compliant\") != null) and (.trigger.data.payment_compliant == false)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Contractor"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "payment_compliance_violation_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendComplianceNotification",
            "args": {
              "violation_type": "payment_compliance"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendComplianceNotification"
  }
}