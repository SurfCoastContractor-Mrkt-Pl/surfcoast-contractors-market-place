{
  "name": "Auto-convert high-rated reviews to testimonials",
  "description": "",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Review"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_convert_high_rated_reviews_to_testimonials",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "createTestimonialFromReview",
            "args": {
              "auto_convert": true
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "createTestimonialFromReview"
  }
}