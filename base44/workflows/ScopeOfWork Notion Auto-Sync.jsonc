{
  "name": "ScopeOfWork Notion Auto-Sync",
  "description": "Automatically creates and syncs ScopeOfWork records to Notion project pages on create/update events\"",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "ScopeOfWork"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "scopeofwork_notion_auto_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notionAutoSync",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notionAutoSync"
  }
}