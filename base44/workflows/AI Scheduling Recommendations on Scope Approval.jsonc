{
  "name": "AI Scheduling Recommendations on Scope Approval",
  "description": "Generate AI scheduling recommendations when a new scope is approved",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ScopeOfWork"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ai_scheduling_recommendations_on_scope_approval",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "aiSchedulingAssistant",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "aiSchedulingAssistant"
  }
}