{
  "name": "Appeal Approved Notification",
  "description": "Sends email notification when a contractor's compliance appeal is approved",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ComplianceAppeal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "appeal_approved_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendComplianceNotification",
            "args": {
              "violation_type": "appeal_approved"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendComplianceNotification"
  }
}