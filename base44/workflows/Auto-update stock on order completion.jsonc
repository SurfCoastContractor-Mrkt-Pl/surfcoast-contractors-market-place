{
  "name": "Auto-update stock on order completion",
  "description": "Automatically deducts inventory from MarketListing when a ConsumerOrder is marked as completed.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ConsumerOrder"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_update_stock_on_order_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "updateStockOnOrderComplete",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "updateStockOnOrderComplete"
  }
}