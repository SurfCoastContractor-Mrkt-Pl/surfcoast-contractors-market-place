{
  "name": "Moderate New & Updated Vendor Reviews",
  "description": "Automatically moderates vendor reviews for inappropriate content. Flags violations, applies 2-star penalty rating, hides the review, and sends a warning email to the reviewer.",
  "trigger": {
    "condition": "${ ((.trigger.data.moderation_status != \"approved\") and (.trigger.data.moderation_status != \"flagged_inappropriate\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "VendorReview"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "moderate_new_updated_vendor_reviews",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onReviewCreatedOrUpdated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onReviewCreatedOrUpdated"
  }
}