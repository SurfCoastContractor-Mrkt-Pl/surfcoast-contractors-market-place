{
  "name": "Auto-Update Reward Tier on Game Session Complete",
  "description": "Automatically recalculates contractor reward tier and achievements when a game session is completed or updated.",
  "trigger": {
    "condition": "${ (.trigger.data.is_solved == true) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "UserGameSession"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_update_reward_tier_on_game_session_complete",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "calculateGameRewardTier",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "calculateGameRewardTier"
  }
}