{
  "name": "Review Request on Job Closeout",
  "description": "Send review request email to customer after job is closed",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"closed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ScopeOfWork"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "review_request_on_job_closeout",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "triggerReviewEmailOnJobClose",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "triggerReviewEmailOnJobClose"
  }
}