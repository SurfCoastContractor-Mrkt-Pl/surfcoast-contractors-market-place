{
  "name": "Set Contractor On Active Job on Scope Approval",
  "description": "When a ScopeOfWork is updated to 'approved', sets is_on_active_job=true and availability_status='booked' on the contractor to prevent new job acceptance.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"approved\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ScopeOfWork"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "set_contractor_on_active_job_on_scope_approval",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onScopeApproved",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onScopeApproved"
  }
}