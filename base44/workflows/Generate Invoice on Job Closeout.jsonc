{
  "name": "Generate Invoice on Job Closeout",
  "description": "Automatically generate and email invoices when a job scope is marked as closed",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ScopeOfWork"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "generate_invoice_on_job_closeout",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateInvoiceOnCloseout",
            "args": {
              "x-internal-service-key": "{{INTERNAL_SERVICE_KEY}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateInvoiceOnCloseout"
  }
}